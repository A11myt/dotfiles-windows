# whkd – Tastenkürzel für komorebi, Belegung wie Hyprland auf dem Laptop (Win = SUPER)
# Übersicht: docs/keybindings-windows.md · neu laden: Win+Shift+O (komorebi), Win+Alt+O (whkd)
# Win+L, Win+I, Win+Tab, Win+` (Terminal), Win+V (Zwischenablage), Win+Shift+S (Screenshot),
# Win+A/Win+N bleiben bei Windows. install.ps1 schaltet die störenden Windows-Kombis ab
# (Win+1–7, Q, C, F, D, O, W; Andocken mit Win+Pfeilen).
.shell powershell

# ── Fenster ──
win + c                 : komorebic close
win + f                 : komorebic toggle-maximize
win + shift + f         : komorebic toggle-monocle
win + shift + space     : komorebic toggle-float
win + o                 : komorebic flip-layout horizontal
win + d                 : komorebic cycle-layout next
win + shift + r         : komorebic retile
win + shift + p         : komorebic toggle-pause

# ── Programme ──
win + q                 : Start-Process wt
win + ctrl + o          : Start-Process "obsidian://open"
win + w                 : Start-Process "ms-settings:personalization-background"

# ── Fokus ──
win + left              : komorebic focus left
win + right             : komorebic focus right
win + up                : komorebic focus up
win + down              : komorebic focus down

# ── Fenster verschieben ──
win + shift + left      : komorebic move left
win + shift + right     : komorebic move right
win + shift + up        : komorebic move up
win + shift + down      : komorebic move down

# ── Größe ändern ──
win + ctrl + left       : komorebic resize-axis horizontal decrease
win + ctrl + right      : komorebic resize-axis horizontal increase
win + ctrl + up         : komorebic resize-axis vertical decrease
win + ctrl + down       : komorebic resize-axis vertical increase

# ── Arbeitsflächen (komorebi zählt ab 0) ──
win + 1                 : komorebic focus-workspace 0
win + 2                 : komorebic focus-workspace 1
win + 3                 : komorebic focus-workspace 2
win + 4                 : komorebic focus-workspace 3
win + 5                 : komorebic focus-workspace 4
win + 6                 : komorebic focus-workspace 5
win + 7                 : komorebic focus-workspace 6

# ── Fenster auf Arbeitsfläche ──
win + shift + 1         : komorebic move-to-workspace 0
win + shift + 2         : komorebic move-to-workspace 1
win + shift + 3         : komorebic move-to-workspace 2
win + shift + 4         : komorebic move-to-workspace 3
win + shift + 5         : komorebic move-to-workspace 4
win + shift + 6         : komorebic move-to-workspace 5
win + shift + 7         : komorebic move-to-workspace 6

# ── komorebi / whkd neu laden ──
win + shift + o         : komorebic reload-configuration
win + alt + o           : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
