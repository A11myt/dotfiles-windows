{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.bar.json",
  "height": 34,
  "font_family": "Iosevka NF",
  "font_size": 11,
  "icon_scale": 1.2,
  "transparency_alpha": 0,
  "padding": {
    "horizontal": 4,
    "vertical": 2
  },
  "widget_spacing": 8,
  "grouping": {
    "kind": "Widget",
    "style": "Default",
    "rounding": 14,
    "transparency_alpha": 235
  },
  "theme": {
    "palette": "Base16",
    "name": "GruvboxDarkMedium",
    "accent": "Base0D"
  },
  "left_widgets": [
    {
      "Time": {
        "enable": true,
        "format": "TwentyFourHourWithoutSeconds",
        "label_prefix": "None"
      }
    },
    {
      "Date": {
        "enable": true,
        "format": {
          "Custom": "%d.%m."
        },
        "label_prefix": "None"
      }
    },
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": true,
          "display": "AllIconsAndText"
        },
        "layout": {
          "enable": true,
          "display": "Icon"
        }
      }
    }
  ],
  "center_widgets": [
    {
      "Komorebi": {
        "focused_container": {
          "enable": true,
          "show_icon": true,
          "display": "IconAndText"
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Cpu": {
        "enable": true
      }
    },
    {
      "Memory": {
        "enable": true
      }
    },
    {
      "Network": {
        "enable": true,
        "show_activity": false,
        "show_total_activity": false
      }
    },
    {
      "Battery": {
        "enable": true
      }
    }
  ],
  "margin": {
    "horizontal": 6,
    "vertical": [
      4,
      0
    ]
  }
}
